    {
      "id": "g4FQbAO8YJu61ObKWTIWd",
      "type": "text",
      "x": -64.26785238452678,
      "y": 466.9812910763561,
      "width": 745.2266879320106,
      "height": 211.26041556546969,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1830904459,
      "version": 886,
      "versionNonce": 1781695371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794375989273,
      "created": 1794374939284,
      "link": null,
      "locked": false,
      "text": "1. 2 new parameters (alpha = -infinity, beta = + positive infinity)\n2 Only maximizing player sets the alpha and minimizing player for beta\n3. set the score / eval to either alpha or better (depends on the current\nstriker)\n4. after evaluating and assigning the \"EVAL\" score to either alpha / beta\ncompare the alpha and betta value:\n    a <= b, if alpha is greater than beta (it means that the current node call\nalready found the best option / move) then prune the current branch (break the\nloop) ",
      "fontSize": 18.77870360581953,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 2 new parameters (alpha = -infinity, beta = + positive infinity)\n2 Only maximizing player sets the alpha and minimizing player for beta\n3. set the score / eval to either alpha or better (depends on the current striker)\n4. after evaluating and assigning the \"EVAL\" score to either alpha / beta compare the alpha and betta value:\n    a <= b, if alpha is greater than beta (it means that the current node call already found the best option / move) then prune the current branch (break the loop) ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
